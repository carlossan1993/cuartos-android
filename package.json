{
  "name": "cuartos-android",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/privacy-pages.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run && node --test scripts/bundle-report.test.mjs",
    "check:bundles": "node scripts/bundle-report.mjs",
    "test:e2e": "playwright test",
    "test:qa": "playwright test --config=playwright.qa.config.ts",
    "test:android:smoke": "node e2e/android-smoke.ts",
    "android:sync": "npm run build && cap sync android",
    "play:assets": "playwright test --config=playwright.play.config.ts",
    "play:check": "node scripts/check-play.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@react-three/fiber": "9.8.2",
    "dexie": "4.4.6",
    "i18next": "26.5.5",
    "konva": "10.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.2",
    "react-konva": "19.3.2",
    "three": "0.186.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.58.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "oxlint": "1.89.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <13"
  }
}
